{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "testCases"],
  "properties": {
    "summary": { "type": "string", "maxLength": 500 },
    "testCases": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewpointId", "title", "type", "priority", "preconditions", "testData", "steps", "state"],
        "properties": {
          "viewpointId": { "type": "string", "maxLength": 100 },
          "title": { "type": "string", "maxLength": 240 },
          "type": { "type": "string", "enum": ["正常系", "異常系", "境界値", "状態遷移", "探索的"] },
          "priority": { "type": "string", "enum": ["高", "中", "低"] },
          "preconditions": { "type": "string", "maxLength": 1500 },
          "testData": { "type": "string", "maxLength": 1500 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string", "maxLength": 1500 },
                "expected": { "type": "string", "maxLength": 1500 }
              }
            }
          },
          "state": { "type": "string", "enum": ["draft", "review"] }
        }
      }
    }
  }
}
